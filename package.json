{
  "name": "baixai",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Comprima, converta e corte vídeos com processamento local no navegador.",
  "scripts": {
    "assets": "node scripts/copy-engine.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "start": "npm run dev",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "test": "vitest run src",
    "test:fixtures": "node scripts/create-fixtures.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource/archivo-black": "^5.2.0",
    "@fontsource/dm-mono": "^5.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ffmpeg-static": "5.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
